{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "songou",
  "version": "0.1.0",
  "identifier": "com.marti.songou",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "songou",
        "width": 1100,
        "height": 760,
        "visible": false
      },
      {
        "label": "peaks",
        "url": "peaks.html",
        "title": "songou peaks",
        "width": 320,
        "height": 200,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
